+export async function sendKeys(pane, text, preActionEnterDelaySeconds = 0) {
+  // Wake/dismiss any modal prompt by sending a bare Enter first. Claude Code
+  // shows a "wait / upgrade plan / restart" menu when tokens are exhausted;
+  // pressing Enter selects the highlighted default (typically "wait") and
+  // returns to the input prompt so our retry message lands correctly.
+  if (preActionEnterDelaySeconds > 0) {
+    await execFileAsync('tmux', ['send-keys', '-t', pane, 'Enter']);
+    await new Promise((r) => setTimeout(r, preActionEnterDelaySeconds * 1000));
+  }
+  // Split text and Enter to work around Claude Code TUI (Ink/bracketed-paste)
+  // interpreting a batched Enter as a newline instead of submit. See upstream
+  // issue #7.
+  await execFileAsync('tmux', ['send-keys', '-t', pane, text]);
+  await new Promise((r) => setTimeout(r, SEND_KEYS_ENTER_DELAY_MS));
+  await execFileAsync('tmux', ['send-keys', '-t', pane, 'Enter']);
 }
 
